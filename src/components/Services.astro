---
import { site } from "../data/site";
---

<section class="section section-services" id="servicios">
  <div class="wrap">
    <div class="section-head section-head-center">
      <p class="eyebrow eyebrow-dark">Servicios profesionales</p>
      <h2>Soluciones pensadas para cada necesidad</h2>
      <p class="section-lead">
        Asesoramiento inmobiliario con respaldo de matrícula profesional, criterio técnico y un trato cercano en Córdoba Capital.
      </p>
    </div>
    <div class="cards">
      {site.services.map((service, index) => (
        <article class="card service-card">
          <div class="service-card-media">
            <img src={service.image} alt={service.alt} loading="lazy" width="1200" height="800" />
            <span class="card-index service-card-index">{String(index + 1).padStart(2, "0")}</span>
          </div>
          <div class="service-card-body">
            <p class="service-card-tag">{service.detail}</p>
            <h3>{service.name}</h3>
            <p>{service.summary}</p>
            <div class="card-line" aria-hidden="true"></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section-profile" id="perfil">
  <div class="wrap profile-grid">
    <div class="profile-image-wrap">
      <img
        class="profile-logo"
        src={site.colegioLogo.src}
        alt={site.colegioLogo.alt}
        width="720"
        height="420"
        loading="lazy"
      />
    </div>
    <div class="profile-copy">
      <p class="eyebrow eyebrow-dark">Perfil profesional</p>
      <h2>Respaldo profesional y atención personalizada</h2>
      <p class="profile-text">
        {site.professionalName} brinda servicios inmobiliarios con matrícula profesional, ofreciendo claridad, confianza y acompañamiento en cada consulta.
      </p>
      <div class="profile-highlights" aria-label="Valores de atención">
        <span class="profile-highlight">Criterio técnico</span>
        <span class="profile-highlight">Trato cercano</span>
        <span class="profile-highlight">Respaldo matriculado</span>
      </div>
      <dl class="profile-details">
        <div>
          <dt>Matrícula</dt>
          <dd>{site.license}</dd>
        </div>
        <div>
          <dt>Profesión</dt>
          <dd>{site.title}</dd>
        </div>
        <div>
          <dt>Ubicación</dt>
          <dd>{site.location}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
