---
import { site } from "../data/site";
---

<section class="section section-contact" id="contacto">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <p class="eyebrow">Contacto</p>
      <h2>Realice su consulta</h2>
      <p class="contact-lead">
        Para consultas sobre tasaciones o administración de inmuebles, puede comunicarse por WhatsApp, teléfono o correo electrónico.
      </p>
      <div class="contact-actions">
        <a class="btn btn-primary" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">
          Escribir por WhatsApp
        </a>
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>Enviar correo</a>
      </div>
    </div>

    <div class="contact-panel">
      <div class="contact-item">
        <span class="contact-label"><span class="contact-icon" aria-hidden="true">📱</span> WhatsApp / Teléfono</span>
        <a class="contact-value" href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">{site.phoneDisplay}</a>
      </div>
      <div class="contact-item">
        <span class="contact-label"><span class="contact-icon" aria-hidden="true">✉️</span> Correo electrónico</span>
        <a class="contact-value" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="contact-item">
        <span class="contact-label"><span class="contact-icon" aria-hidden="true">📜</span> Matrícula</span>
        <span class="contact-value">{site.license}</span>
      </div>
      <div class="contact-item">
        <span class="contact-label"><span class="contact-icon" aria-hidden="true">📍</span> Ubicación</span>
        <span class="contact-value">{site.location}</span>
      </div>
    </div>
  </div>
</section>
